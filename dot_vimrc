syntax on

"-- file
set fileformat=unix
set encoding=UTF-8

"-- formatting
set tabstop=2
set softtabstop=2
set shiftwidth=2
set autoindent
set smartindent
set smarttab
set expandtab

"-- vim window + invisible characters
set nowrap
set list
set listchars=eol:.,tab:>-,trail:~,extends:>,precedes:<

"-- line relative
set number
set relativenumber
set scrolloff=8
set signcolumn=yes
nmap <F4> :exec &nu==&rnu? "se nu!" : "se rnu!"<CR>

"-- command
set showcmd
set noshowmode
set conceallevel=1

"-- search settings
set ignorecase
set smartcase
set incsearch
set hlsearch

"-- mouse
set mouse=a

call plug#begin()
  " Plugin list
  Plug 'vim-airline/vim-airline'
  Plug 'preservim/nerdtree'
 call plug#end()
